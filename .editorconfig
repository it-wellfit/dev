# =============================================================================
# Workspace Root EditorConfig — Encoding & Line Ending Standard
# All files: UTF-8 (supports Traditional Chinese + Simplified Chinese + all Unicode)
# Handles special encodings, base-N formats, binary/positional files
# =============================================================================

root = true

[*] charset = utf-8 end_of_line = lf insert_final_newline = true trim_trailing_whitespace = true max_line_length = 120

# Source code
[*.rs] charset = utf-8 end_of_line = lf insert_final_newline = true trim_trailing_whitespace = true
[*.toml] charset = utf-8 end_of_line = lf insert_final_newline = true trim_trailing_whitespace = true
[*.json] charset = utf-8 end_of_line = lf insert_final_newline = true trim_trailing_whitespace = true
[*.yml] charset = utf-8 end_of_line = lf insert_final_newline = true trim_trailing_whitespace = true
[*.yaml] charset = utf-8 end_of_line = lf insert_final_newline = true trim_trailing_whitespace = true
[*.ps1] charset = utf-8 end_of_line = lf insert_final_newline = true trim_trailing_whitespace = true
[*.sh] charset = utf-8 end_of_line = lf insert_final_newline = true trim_trailing_whitespace = true
[*.html] charset = utf-8 end_of_line = lf insert_final_newline = true trim_trailing_whitespace = true
[*.css] charset = utf-8 end_of_line = lf insert_final_newline = true trim_trailing_whitespace = true
