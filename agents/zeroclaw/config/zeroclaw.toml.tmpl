# ZeroClaw portable config template.
#
# Placeholders are rendered by scripts/install.ps1 (Windows) or scripts/install.sh
# (Linux/macOS/WSL2). Never commit a rendered copy: it may contain machine paths.
#
# Secrets are NOT stored here. Inject them at runtime, e.g.
#   ZEROCLAW_providers__models__gemini__free__api_key=<key>
# or set them through the masked prompt:
#   zeroclaw config set providers.models.gemini.free.api_key
#
# Schema version 4 is the current on-disk format (see docs/reference/config.md).

schema_version = 4

[runtime]
# Pin the interpreter so command policy and behaviour are identical everywhere.
# "powershell" = Windows PowerShell 5.1, "pwsh" = PowerShell 7+, "cmd" = cmd.exe.
shell = "powershell"
# kind = "native"

[tools]
# No optional tools: on a host without an OS sandbox the default tool surface is
# kept as small as possible. Add single names here once measured and needed.
optional = []

[memory]
# No embedding provider is configured (free/local decision), so hybrid search
# cannot do vector recall. Keyword-only matches reality and drops the startup
# warning. Change this only together with a real embedding provider.
search_mode = "bm25"

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------

# Primary: local Ollama. Use the native API path, never "/v1":
# the OpenAI-compatible route makes tool calling unreliable.
[providers.models.ollama.local]
model = "__PRIMARY_MODEL__"
uri = "http://127.0.0.1:11434"
num_ctx = 8192
num_predict = 1024
# Free hosted fallover, no credential required (verified 2026-11-16).
fallback = ["kilo.free"]

# Free hosted fallback: Kilo AI Gateway, free model tier.
# Verified 2026-11-16: /v1/chat/completions answers WITHOUT an api_key
# (200, cost: 0, tool calls supported). Free models are shared with OpenRouter's
# ":free" set plus kilo-auto/free and reflection/beam-free.
# Documented limit for free models: 200 requests/hour per IP (429 beyond).
# Add api_key only if you want the paid/balanced tiers as well.
[providers.models.kilo.free]
model = "kilo-auto/free"
timeout_secs = 120
# The gateway serves free models without auth, but ZeroClaw's local credential
# gate requires a non-empty api_key before it will use (or fall back to) the
# alias. A placeholder satisfies the local gate and is ignored upstream
# (verified 2026-11-16: HTTP 200, cost 0). Replace with a real key only when you
# want the paid tiers, and inject it from the env instead of committing it.
api_key = "anonymous"

# Optional: Google Gemini API free tier (needs a key; content may be used by
# Google to improve their products). Enable only after the key exists:
# ZeroClaw refuses to start when a configured fallback has no usable credential.
# [providers.models.gemini.free]
# model = "__FALLBACK_MODEL__"
# fallback_models = ["gemini-3.5-flash-lite"]
# timeout_secs = 60

# ---------------------------------------------------------------------------
# Agent: the join between provider, risk profile and runtime profile
# ---------------------------------------------------------------------------

[agents.assistant]
model_provider = "ollama.local"
risk_profile = "local"
runtime_profile = "bounded"

[agents.assistant.workspace]
# Never grant unrestricted filesystem access on a host without an OS sandbox.
unrestricted_filesystem = false
read_memory_from = []

# Memory backend is chosen here (default: sqlite). It is locked once the agent
# has written on-disk data, so decide before the first real run.

# ---------------------------------------------------------------------------
# Runtime profile: bounds cost and latency
# ---------------------------------------------------------------------------

[runtime_profiles.bounded]
agentic = true
max_tool_iterations = 8
max_history_messages = 40
max_context_tokens = 32000

# ---------------------------------------------------------------------------
# Risk profile: application-layer security only (Windows has no OS sandbox)
# ---------------------------------------------------------------------------

[risk_profiles.local]
level = "supervised"
workspace_only = true
# The agent workspace (<data_dir>/agents/<alias>/workspace) is always writable.
# allowed_roots would grant access outside it: keep it empty.
allowed_roots = []
forbidden_paths = [
__FORBIDDEN__
]
# Empty means "default policy"; a non-empty list is strict: anything not listed
# is blocked. Fill it from measurements, not guesses (see README).
allowed_commands = []
sandbox_enabled = false
sandbox_backend = "none"
shell_env_passthrough = []
# Add exact browser/hardware tool names here once enumerated on this build.
excluded_tools = []

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------

[gateway]
# Pairing must stay on so /api/* is not open to any local process.
require_pairing = true
# Bind address stays at the shipped default (loopback). Confirm the exact key
# with `zeroclaw config schema` before changing it; never expose 42617 to a LAN.