{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    // 純 Rust 瀏覽器自動化（Chrome DevTools Protocol；無 Node.js 依賴）。
    // 取代 VS Code 擴充內建（硬編碼 npx）的 Browser Automation，見 .kilo/plans/1794723523697-*。
    "browser": {
      "type": "local",
      "command": [
        "C:\\Users\\stephanie.huang\\.cargo\\bin\\browser-mcp.exe"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "sequentialthinking": {
      "type": "local",
      "command": [
        "C:\\Users\\stephanie.huang\\.bun\\bin\\bunx.exe",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "C:\\Users\\stephanie.huang\\.bun\\bin\\bunx.exe",
        "@playwright/mcp"
      ],
      "enabled": false
    },
    "crates-io": {
      "type": "local",
      "command": [
        "C:\\Users\\stephanie.huang\\.cargo\\bin\\cratesio-mcp.exe"
      ],
      "enabled": true
    },
    "rust-analyzer": {
      "type": "local",
      "command": [
        "C:\\Users\\stephanie.huang\\.cargo\\bin\\rust-analyzer-mcp.exe"
      ],
      "enabled": true
    },
    "narsil": {
      "type": "local",
      "command": [
        "C:\\Users\\stephanie.huang\\.bun\\bin\\narsil-mcp.exe",
        "--repos",
        "."
      ],
      "enabled": true
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "grep-app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "jina": {
      "type": "remote",
      "url": "https://mcp.jina.ai/v1",
      "enabled": true
    }
  },
  "indexing": {
    "model": "mistralai/mistral-embed-2312"
  },
  "instructions": [
    ".kilo/memories/corrections.md",
    ".kilo/memories/project.md"
  ],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "external_directory": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "allow",
    "codesearch": "allow"
  }
}