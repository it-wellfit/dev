{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flaps ERP",
  "version": "0.1.0",
  "identifier": "com.flaps.erp",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Flaps ERP - 企業資源規劃系統",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": []
  }
}
